# Store text files with LF line endings in the repository; Git converts them to the platform's native
# line endings on checkout. Keeps diffs clean regardless of the contributor's OS or editor settings.
* text=auto

# Always LF, even on Windows checkouts (shell scripts and tools that require it).
*.sh text eol=lf
*.mjs text eol=lf

# Windows-only files keep CRLF.
*.sln text eol=crlf
*.ps1 text eol=crlf

# Binary files: never normalise or diff as text.
*.png binary
*.ico binary
*.tgz binary
*.dll binary
*.db binary
