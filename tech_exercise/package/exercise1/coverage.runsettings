<?xml version="1.0" encoding="utf-8"?>
<!-- Usage: dotnet test StargateAPI.sln -settings coverage.runsettings -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[StargateAPI]*</Include>
          <!-- EF Core migrations are generated code; measuring them would inflate the result. -->
          <ExcludeByFile>**/Business/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
